# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Ignore virtual environment
.venv/
venv/
env/
ENV/

# Ignore PyInstaller build output (but keep the build config)
build/
dist/
*.spec
!Debt-Manager.spec

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Keep data folder structure but ignore actual data
data/*.json
data/*.jsonl
data/backups/*.zip

# Ignore exported ledgers (may contain real customer data)
/*.pdf
/*.xlsx
/*.csv

# Ignore logs
*.log

# pytest
.pytest_cache/

# صور مرجعية ولقطات شاشة — تبقى محلية، لا تُنشر.
# X/ فيها صور لتطبيق شخص آخر وأرقام حسابات حقيقية.
X/
screenshots/

# بيانات عملاء حقيقية من جهاز المحل — لا تُرفع أبداً (المستودع عام)
CustomerData/
*-CustomerData/
